# Your Managed Agents ids. Copy this file to .env (same folder) and fill in your own values:
#   cp .env.example .env
# tools/ma_client.py and the local web app (ui/start.sh) read these three lines; a variable exported in the
# terminal wins over .env. The ids are not secrets. Never put ARK_API_KEY here: export it in the terminal.
MA_AGENT_ID=agent-...
MA_ENV_ID=env-...
MA_VAULT_ID=vlt-...
